# ⚠️ 演示项目，非客户案例。复制为真实环境变量使用（MCP 客户端里通常写在 mcpServers.env 或 claude mcp add -e 里）

# ── 数据层开关 ────────────────────────────────────────────────
# 是否使用内置 mock 演示数据（默认 true：不需要任何真实 Chatwoot 实例即可跑通全部 17 个工具）
# 设为 false 时走真实 Chatwoot Application API（应用接口），此时 CHATWOOT_BASE_URL 必填
CHATWOOT_MOCK=true

# ── 真实实例模式（CHATWOOT_MOCK=false 时生效）─────────────────
# Chatwoot 根地址，例如自托管实例 https://support.yourcompany.com 或官方云版 https://app.chatwoot.com
CHATWOOT_BASE_URL=
# 用户 API token：登录 Chatwoot → 个人资料设置（Profile Settings）→ API token 复制
CHATWOOT_API_ACCESS_TOKEN=
# 账号 ID（Chatwoot 每个账号有数字 ID，单账号自托管通常为 1；URL 里 /app/accounts/<数字>/ 可见）
CHATWOOT_ACCOUNT_ID=1
# 鉴权头格式：header = api_access_token 请求头（所有版本可用，官方标注未来弃用）；
# bearer = Authorization: Bearer <token>（官方标注 v4.19.0 及以后可用）
CHATWOOT_AUTH=header

# ── 通用桥接白名单（chatwoot_api 工具可转发的路径前缀，METHOD:路径，逗号分隔）──
# 路径里的 {account_id} 会替换成 CHATWOOT_ACCOUNT_ID。默认只放行只读查询；要开放写路径请自行追加
# 示例：CHATWOOT_API_WHITELIST="GET:/api/v1/accounts/{account_id}/conversations,POST:/api/v1/accounts/{account_id}/conversations/{conversation_id}/messages"
# （留空 = 用默认只读白名单；设为 none = 禁用 chatwoot_api 工具）

# ── 传输层 ────────────────────────────────────────────────────
# --http 模式监听端口（扣子等 URL 型客户端）
CHATWOOT_MCP_HTTP_PORT=3002
